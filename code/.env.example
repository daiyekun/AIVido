ENV=dev
APP_NAME=ainew
APP_VERSION=1.0.0
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://ainew:ainew@localhost:55432/ainew
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10

REDIS_URL=redis://localhost:6380/0

MQ_URL=amqp://ainew:ainew@localhost:5673/ainew
MQ_API=http://localhost:15673/api
MQ_USER=ainew
MQ_PASS=ainew
MQ_VHOST=ainew
MQ_API_TIMEOUT=10

MINIO_ENDPOINT=localhost:9010
MINIO_PUBLIC_ENDPOINT=http://localhost:9010
MINIO_ACCESS_KEY=ainew-app
MINIO_SECRET_KEY=change-me
MINIO_SECURE=false
MINIO_BUCKET_INPUT=ai-input
MINIO_BUCKET_OUTPUT=ai-output
MINIO_BUCKET_THUMB=ai-thumb
MINIO_BUCKET_BACKUP=ai-backup
SIGNED_URL_EXPIRE_MINUTES=60

JWT_SECRET=change-me-to-a-random-32-bytes-secret
JWT_EXPIRE_DAYS=7

SMS_PROVIDER_KEY=
SMS_PROVIDER_URL=
SMS_DEV_FIXED_CODE=123456
SMS_CODE_TTL_SECONDS=300
SMS_RATE_SECONDS=60
SMS_DAILY_LIMIT=10
DEV_SMS_ENDPOINT=false

UPLOAD_IMAGE_MAX_MB=10
UPLOAD_VIDEO_MAX_MB=200
CLIENT_MAX_BODY_SIZE=210

MODEL_CALL_CONNECT_TIMEOUT=10
MODEL_CALL_TIMEOUT_IMAGE=300
MODEL_CALL_TIMEOUT_VIDEO=600
MODEL_CALL_TIMEOUT_CHAT=60
MODEL_TRANSPORT_RETRIES=2
MODEL_BREAKER_THRESHOLD=10
MODEL_BREAKER_RESET_SECONDS=60
MODEL_RATE_LIMIT_PER_MINUTE=120

# 第三方模型密钥（真实密钥只存环境变量；后台模型 config_json 里以变量名引用，如 {"api_key_env": "WANXIANG_API_KEY"}）
WANXIANG_API_KEY=

TASK_RETRY_DELAYS=30,120,600
TASK_VISIBILITY_TIMEOUT=3600

OTEL_SERVICE_NAME=ainew-api
OTEL_EXPORTER=log
OTEL_SAMPLE_RATIO=1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

SENSITIVE_WORDS_PATH=
